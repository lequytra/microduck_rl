<mujoco model="microduck_object_rubber_ball">
    <!-- Rubber ball: 30 mm diameter, solid, 15 g. Grab height = 30 mm, the
         highest of the three, so it needs the shallowest crouch.

         It is also the prop that punishes a sloppy approach: it rolls away from
         any off-axis contact, which is what object_disturb_penalty exists to
         price. Friction is the highest of the three (rubber) to give the beak
         something to hold once it is actually around it. -->
    <worldbody>
        <body name="rubber_ball" pos="0.2 0.3 0.015">
            <freejoint name="rubber_ball_free"/>
            <inertial pos="0 0 0" mass="0.015" diaginertia="1.35e-6 1.35e-6 1.35e-6"/>
            <geom name="rubber_ball_geom" type="sphere" size="0.015"
                  condim="4" friction="1.3 0.02 0.0005" solref="0.01 1"
                  solimp="0.95 0.99 0.001 0.5 2" priority="2"
                  rgba="0.85 0.15 0.15 1"/>
        </body>
    </worldbody>
</mujoco>
